; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FPSGame"
config/description="Arcade light-gun shooter, remade from Unity 2019.4 project."
run/main_scene="res://scenes/ui/startup.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[autoload]

GlobalObject="*res://autoload/global_object.gd"
InputManager="*res://autoload/input_manager.gd"
DataMgr="*res://autoload/data_mgr.gd"
PlayerSystem="*res://autoload/player_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Enemy"
3d_physics/layer_3="Button"
3d_physics/layer_4="CameraWall"
